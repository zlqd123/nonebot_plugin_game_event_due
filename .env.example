# 本文件只列出本插件相关变量，复制到 bot 的 .env 中按需启用。
# 嵌套配置用双下划线：DAILY_PUSH__HOUR 对应 Config.daily_push.hour

# ---- 总开关 ----
GAME_EVENT_DUE_ENABLED=true

# ---- 检查节奏与窗口 ----
# 每天几点检查一次（东八区）。一天只跑这一轮。
GAME_EVENT_DUE_DAILY_PUSH__HOUR=12
GAME_EVENT_DUE_DAILY_PUSH__MINUTE=0
# 检查点秒数：固定 12:00:01，别改成 0。上游时间戳都是整点，差这一秒
# 才能让 12:00:00 开始/结束的活动归属无歧义（严格判定，不加整点例外）。
GAME_EVENT_DUE_CHECK_SECOND=1
# 窗口宽度（小时），检查点前后各取这么长。四组：
#   已开始   C-W <= start <  C
#   即将开始 C   <= start <= C+W
#   即将结束 C   <= end   <= C+W
#   已结束   C-W <= end   <  C
GAME_EVENT_DUE_WINDOW_HOURS=24

# 全量摘要（把订阅游戏的全部活动列一遍）。
# 平时建议关闭：关掉它不影响 12:00 的检查。
GAME_EVENT_DUE_DAILY_PUSH__ENABLED=false
# 摘要推哪些游戏，逗号分隔，支持别名；留空 = 各会话自己订阅的游戏
GAME_EVENT_DUE_DAILY_PUSH__GAMES=
# 摘要目标会话，格式 平台:作用域:ID；留空 = 所有已订阅会话
GAME_EVENT_DUE_DAILY_PUSH__TARGETS=
GAME_EVENT_DUE_DAILY_PUSH__INCLUDE_DEADLINE=true

# ---- 档位提醒（旧路径，不影响 12:00:01 的窗口快照）----
# 窗口快照按固定四组走时间判定，下面这些阈值只作用于每日全量摘要等旧路径。
GAME_EVENT_DUE_DEADLINE_PUSH__ENABLED=true
GAME_EVENT_DUE_DEADLINE_PUSH__THRESHOLDS=1
GAME_EVENT_DUE_START_PUSH__ENABLED=false
GAME_EVENT_DUE_START_PUSH__THRESHOLDS=1

# 静默时段：命中但落在这段时间内就推迟到时段结束。留空 = 全天可推
GAME_EVENT_DUE_QUIET_HOURS=23-8

# ---- 新活动提醒 ----
GAME_EVENT_DUE_NOTIFY_NEW_ACTIVITY=true
GAME_EVENT_DUE_NEW_ACTIVITY_LOOKAHEAD_DAYS=45
GAME_EVENT_DUE_MAX_NEW_PER_CYCLE=8
GAME_EVENT_DUE_NOTIFY_ON_SUBSCRIBE=true
GAME_EVENT_DUE_STATE_RETENTION_DAYS=30

# ---- 数据源与缓存 ----
GAME_EVENT_DUE_REQUEST_TIMEOUT=20
GAME_EVENT_DUE_PROXY=
# 缓存目录；留空则用 nonebot-plugin-localstore，再退化为包内 .cache
GAME_EVENT_DUE_CACHE_DIR=
# 手动刷新时的缓存最大年龄（小时）；每天的检查会强制取数，不受它限制
GAME_EVENT_DUE_FETCH_INTERVAL_HOURS=8
GAME_EVENT_DUE_REFRESH_ON_START=true

# ---- 消息格式 ----
GAME_EVENT_DUE_SINGLE_MESSAGE_PER_GAME=true
GAME_EVENT_DUE_URGENCY_MARKER=true
GAME_EVENT_DUE_SORT_BY_URGENCY=true
# 活动之间的分隔线；设为空最紧凑
GAME_EVENT_DUE_ACTIVITY_SEPARATOR=
# 有版本主视觉时配一张图；没有图自动只发文字
# QQ 官方 Bot 一条消息只能带一张图，多游戏会按游戏拆成多条
GAME_EVENT_DUE_INSERT_COVER=true
# 自定义游戏显示名，如 ak=舟游,end=终末地
GAME_EVENT_DUE_GAME_ALIASES=

# ---- 预置订阅（唯一的订阅入口）----
# 格式：会话key=游戏@结束档位~开始档位
#   @1   = 结束前不足 1 天提醒
#   ~1   = 开始前不足 1 天提醒
#   @1~1 = 两个方向都要
#   @~   = 两个方向都关闭
# 多条用换行或分号分隔；私聊会话会被跳过
# 只在配置内容变化时应用一次，不会覆盖群里之后改过的设置
GAME_EVENT_DUE_PRESET_SUBSCRIPTIONS=
